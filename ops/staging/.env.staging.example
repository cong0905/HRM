# ==============================================================================
# HRM STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL PASSWORDS OR PRODUCTION SECRETS TO SOURCE CONTROL.
# Copy this file to `.env.staging` and fill in real values from a secure vault.
# ==============================================================================

# Staging Hostname
STAGING_HOST=staging.hrm.local
STAGING_ORIGIN=https://staging.hrm.local

# Database Passwords (Must meet SQL Server password complexity requirements)
MSSQL_SA_PASSWORD=ChangeMe_StrongSaPassw0rd_2026!
APP_DB_PASSWORD=ChangeMe_AppUserPassw0rd_2026!
MIGRATOR_PASSWORD=ChangeMe_MigratorPassw0rd_2026!

# Runtime Application Connection String (Uses least-privilege `hrm_app_user`)
ConnectionStrings__Hrm=Server=sqlserver,1433;Database=HRM_Next_Staging;User Id=hrm_app_user;Password=ChangeMe_AppUserPassw0rd_2026!;Encrypt=True;TrustServerCertificate=True;Connect Timeout=15;

# Schema Migration Connection String (Uses DDL user `hrm_migrator`)
MIGRATION_CONNECTION_STRING=Server=sqlserver,1433;Database=HRM_Next_Staging;User Id=hrm_migrator;Password=ChangeMe_MigratorPassw0rd_2026!;Encrypt=True;TrustServerCertificate=True;Connect Timeout=30;

# ASP.NET Core Runtime Settings
ASPNETCORE_ENVIRONMENT=Staging
DOTNET_ENVIRONMENT=Staging
DataProtection__KeyDirectory=/app/dataprotection

# Email / Notifications Configuration (T22)
Email__DeliveryMode=dev-sink
Email__ResetUrlOrigin=https://staging.hrm.local
Email__ResetTokenLifespanMinutes=15
Email__SmtpHost=mailhog
Email__SmtpPort=1025
Email__EnableSsl=false
Email__FromAddress=noreply@staging.hrm.local
Email__FromName=HRM Staging Notifications
Email__MaxRetryAttempts=5
Email__BackoffInitialSeconds=10
Email__BackoffMaxSeconds=3600
Email__WorkerPollIntervalSeconds=5

# OpenApi Visibility in Staging
Api__ExposeOpenApi=true
